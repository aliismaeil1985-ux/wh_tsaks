<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0" xsi:type="MailApp">
  <Id>7b3c2f4e-9d1a-4c8e-b6f2-5a7d0e1c3b91</Id>
  <Version>1.0.1.0</Version>
  <ProviderName>Tania Water</ProviderName>
  <DefaultLocale>ar-SA</DefaultLocale>
  <DisplayName DefaultValue="تانيا — تحويل البريد إلى مهمة"/>
  <Description DefaultValue="انقل أي رسالة مهمة في Outlook إلى منصة مهام تانيا بنقرة واحدة، مع المكلَّف والأولوية وتاريخ الاستحقاق."/>
  <IconUrl DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-128.png"/>
  <SupportUrl DefaultValue="https://wh-tsaks.pages.dev/"/>
  <AppDomains>
    <AppDomain>https://wh-tsaks.pages.dev</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://wh-tsaks.pages.dev/outlook/taskpane.html"/>
        <RequestedHeight>360</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="taniaGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="taniaQuick">
                    <Label resid="Quick.Label"/>
                    <Supertip><Title resid="Quick.Label"/><Description resid="Quick.Tip"/></Supertip>
                    <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                    <Action xsi:type="ExecuteFunction"><FunctionName>quickTask</FunctionName></Action>
                  </Control>
                  <Control xsi:type="Button" id="taniaPane">
                    <Label resid="Pane.Label"/>
                    <Supertip><Title resid="Pane.Label"/><Description resid="Pane.Tip"/></Supertip>
                    <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                    <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
      </Host>
    </Hosts>
        <Resources>
          <bt:Images>
            <bt:Image id="Icon.16" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-16.png"/>
            <bt:Image id="Icon.32" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-32.png"/>
            <bt:Image id="Icon.80" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-80.png"/>
          </bt:Images>
          <bt:Urls>
            <bt:Url id="Commands.Url" DefaultValue="https://wh-tsaks.pages.dev/outlook/commands.html"/>
            <bt:Url id="Taskpane.Url" DefaultValue="https://wh-tsaks.pages.dev/outlook/taskpane.html"/>
          </bt:Urls>
          <bt:ShortStrings>
            <bt:String id="Group.Label" DefaultValue="تانيا — المهام"/>
            <bt:String id="Quick.Label" DefaultValue="تحويل لمهمة"/>
            <bt:String id="Pane.Label" DefaultValue="مهمة مع خيارات"/>
          </bt:ShortStrings>
          <bt:LongStrings>
            <bt:String id="Quick.Tip" DefaultValue="ينقل هذا البريد بنقرة واحدة ليصبح مهمة عمل في منصة تانيا مُسندة إليك."/>
            <bt:String id="Pane.Tip" DefaultValue="حوّل البريد إلى مهمة مع اختيار المكلَّف والأولوية وتاريخ الاستحقاق."/>
          </bt:LongStrings>
        </Resources>
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.5">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MessageReadCommandSurface">
              <OfficeTab id="TabDefault">
                <Group id="taniaGroup">
                  <Label resid="Group.Label"/>
                  <Control xsi:type="Button" id="taniaQuick">
                    <Label resid="Quick.Label"/>
                    <Supertip><Title resid="Quick.Label"/><Description resid="Quick.Tip"/></Supertip>
                    <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                    <Action xsi:type="ExecuteFunction"><FunctionName>quickTask</FunctionName></Action>
                  </Control>
                  <Control xsi:type="Button" id="taniaPane">
                    <Label resid="Pane.Label"/>
                    <Supertip><Title resid="Pane.Label"/><Description resid="Pane.Tip"/></Supertip>
                    <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
                    <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
                  </Control>
                </Group>
              </OfficeTab>
            </ExtensionPoint>
          </DesktopFormFactor>
          <MobileFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="MobileMessageReadCommandSurface">
              <Group id="taniaMobileGroup">
                <Label resid="Group.Label"/>
                <Control xsi:type="MobileButton" id="taniaMobilePane">
                  <Label resid="Quick.Label"/>
                  <Icon xsi:type="bt:MobileIconList">
                    <bt:Image size="25" scale="1" resid="Icon.25"/>
                    <bt:Image size="25" scale="2" resid="Icon.50"/>
                    <bt:Image size="25" scale="3" resid="Icon.75"/>
                    <bt:Image size="32" scale="1" resid="Icon.32"/>
                    <bt:Image size="32" scale="2" resid="Icon.64"/>
                    <bt:Image size="32" scale="3" resid="Icon.96"/>
                    <bt:Image size="48" scale="1" resid="Icon.48"/>
                    <bt:Image size="48" scale="2" resid="Icon.96"/>
                    <bt:Image size="48" scale="3" resid="Icon.144"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
                </Control>
              </Group>
            </ExtensionPoint>
          </MobileFormFactor>
        </Host>
      </Hosts>
        <Resources>
          <bt:Images>
            <bt:Image id="Icon.16" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-16.png"/>
            <bt:Image id="Icon.32" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-32.png"/>
            <bt:Image id="Icon.80" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-80.png"/>
            <bt:Image id="Icon.25" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-25.png"/>
            <bt:Image id="Icon.48" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-48.png"/>
            <bt:Image id="Icon.50" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-50.png"/>
            <bt:Image id="Icon.64" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-64.png"/>
            <bt:Image id="Icon.75" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-75.png"/>
            <bt:Image id="Icon.96" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-96.png"/>
            <bt:Image id="Icon.144" DefaultValue="https://wh-tsaks.pages.dev/outlook/icon-144.png"/>
          </bt:Images>
          <bt:Urls>
            <bt:Url id="Commands.Url" DefaultValue="https://wh-tsaks.pages.dev/outlook/commands.html"/>
            <bt:Url id="Taskpane.Url" DefaultValue="https://wh-tsaks.pages.dev/outlook/taskpane.html"/>
          </bt:Urls>
          <bt:ShortStrings>
            <bt:String id="Group.Label" DefaultValue="تانيا — المهام"/>
            <bt:String id="Quick.Label" DefaultValue="تحويل لمهمة"/>
            <bt:String id="Pane.Label" DefaultValue="مهمة مع خيارات"/>
          </bt:ShortStrings>
          <bt:LongStrings>
            <bt:String id="Quick.Tip" DefaultValue="ينقل هذا البريد بنقرة واحدة ليصبح مهمة عمل في منصة تانيا مُسندة إليك."/>
            <bt:String id="Pane.Tip" DefaultValue="حوّل البريد إلى مهمة مع اختيار المكلَّف والأولوية وتاريخ الاستحقاق."/>
          </bt:LongStrings>
        </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
